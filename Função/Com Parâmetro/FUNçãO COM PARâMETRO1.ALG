Algoritmo "Função com Parâmetro1"

Var
   nome, NomeDigitado: caracter

funcao saudacao: caracter
Var

   aux: caracter
Inicio
   aux <- "Olá "+nome+", Seja Bem-vindo!"
   retorne aux
fimfuncao

inicio
   leia(NomeDigitado)

   nome <- NomeDigitado

   escreva(saudacao)

Fimalgoritmo